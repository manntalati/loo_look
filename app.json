{
  "expo": {
    "name": "Loo Look",
    "slug": "loo-look",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "loolook",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon-192.png",
      "themeColor": "#000000",
      "backgroundColor": "#000000",
      "display": "standalone",
      "name": "Loo Look",
      "shortName": "Loo Look",
      "description": "Beli for bathrooms — find a good bathroom near you.",
      "orientation": "portrait",
      "startUrl": "/",
      "scope": "/"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Loo Look uses your location to find bathrooms near you."
        }
      ]
    ]
  }
}
